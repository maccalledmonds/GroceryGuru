# Copy this file to .env and fill in values before running locally.
# On Render, set these as Environment Variables in the dashboard.

# USDA Food Data Central API key — get one free at https://fdc.nal.usda.gov/api-key-signup.html
USDA_API_KEY=your_usda_api_key_here

# Comma-separated list of allowed CORS origins (in addition to *.vercel.app).
# Defaults to localhost:5173 and localhost:3000 when unset.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Optional: set to DEBUG for verbose logging
LOG_LEVEL=INFO
